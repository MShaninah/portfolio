# Application environment for the production stack (compose.prod.yaml).
# Copy to .env.prod ON THE SERVER and fill in. Never commit the filled file.

APP_ENV=prod
APP_DEBUG=0

# Generate with: php -r 'echo bin2hex(random_bytes(16)), PHP_EOL;'
# Rotating this invalidates every outstanding admin token.
APP_SECRET=

# The entire admin credential. Generate with:
#   docker compose -f compose.prod.yaml run --rm php-fpm \
#     php bin/console security:hash-password
# Store the HASH here, never the password.
ADMIN_PASSWORD_HASH=

# Optional; the application defaults to 3600 seconds.
#ADMIN_TOKEN_TTL=3600

# Host/credentials must match .env.prod.db. "db" is the compose service name.
DATABASE_URL="mysql://portfolio:CHANGE_ME@db:3306/portfolio?serverVersion=8.0.36&charset=utf8mb4"

# ONE Origin regex -- use | to allow several. Not a JSON array.
CORS_ALLOW_ORIGIN='^https://(www\.)?mshaninah\.com$'

MAILER_DSN=smtp://user:pass@smtp.example.com:587
CONTACT_TO=you@example.com
CONTACT_FROM=no-reply@mshaninah.com

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
