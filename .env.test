# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Test-only credential. The plaintext is "test-password"; this is not a
# secret and is committed deliberately so the test suite can boot.
ADMIN_PASSWORD_HASH='$2y$04$ES/K1A0rvuV78dx2mZJwguYhDIFXtfQI6OzgXFIcPXZHPJt4/ij2O'
ADMIN_TOKEN_TTL=3600
CORS_ALLOW_ORIGIN='^https?://localhost(:[0-9]+)?$'

# Contact form needs a configured mailbox to reach the mailer at all; the
# null:// transport means nothing is actually delivered.
MAILER_DSN=null://null
CONTACT_TO=contact@example.test
CONTACT_FROM=no-reply@example.test

# Tests run against a throwaway SQLite file so the suite needs no MySQL server.
# The schema is built from entity metadata by the test case itself; the MySQL
# migrations are exercised separately via `docker compose run php-cli`.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
